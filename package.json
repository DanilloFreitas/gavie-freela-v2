{
  "name": "gavie-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional da Gavie — camisetas femininas. Homepage implementada a partir do Figma.",
  "scripts": {
    "build:html": "node scripts/build-html.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/styles.css --minify",
    "build": "npm run build:html && npm run build:js && npm run build:fonts && npm run build:css",
    "dev:css": "tailwindcss -i ./src/css/input.css -o ./public/css/styles.css --watch",
    "dev": "npm run build:html && npm run build:js && npm run build:fonts && npm-run-all --parallel dev:css serve",
    "serve": "http-server public -p 5173 -c-1 -o",
    "build:fonts": "node scripts/build-fonts.mjs",
    "verify": "node scripts/verify.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@tailwindcss/cli": "^4.1.11",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.11"
  }
}
